# Environment
NODE_ENV=development
PORT=3000

# Frontend URL (for OAuth redirects and email links)
FRONTEND_URL=http://localhost:3001

# PostgreSQL Database
DATABASE_URL=postgresql://username:password@localhost:5432/notification_platform

# =============================================================================
# REDIS CONFIGURATION (for caching and sessions)
# =============================================================================

REDIS_URL=redis://localhost:6379

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT Configuration (REQUIRED)
JWT_AUTH_SECRET=your-super-secret-jwt-key-at-least-32-characters-long
JWT_REFRESH_SECRET=your-super-secret-refresh-key-at-least-32-characters-long
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# Better Auth Configuration (REQUIRED)
BETTER_AUTH_SECRET=your-better-auth-secret-key-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3001,http://localhost:3000

# Provider Configuration Encryption (REQUIRED)
PROVIDER_ENCRYPTION_KEY=your-32-character-encryption-key-here

# Webhook Security
WEBHOOK_SECRET=your-webhook-secret-key

# =============================================================================
# PRODUCTION MONITORING & ERROR TRACKING
# =============================================================================

# Sentry Error Tracking (for production error monitoring)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# =============================================================================
# PRIMARY COMMUNICATION PROVIDERS
# =============================================================================

# Telnyx API Configuration (Unified SMS + Voice solution - RECOMMENDED)
TELNYX_API_KEY=your-telnyx-api-key
TELNYX_FROM_NUMBER=+1234567890
TELNYX_MESSAGING_PROFILE_ID=your-messaging-profile-id

# Telnyx Voice Configuration
TELNYX_CONNECTION_ID=your-telnyx-connection-id
TELNYX_WEBHOOK_URL=https://your-domain.com/webhooks/telnyx

# WhatsApp Business API Configuration
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=1234567890123456
WHATSAPP_BUSINESS_ACCOUNT_ID=1234567890123456
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-secure-webhook-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret-from-settings
WHATSAPP_API_VERSION=v18.0

# =============================================================================
# EMAIL PROVIDER
# =============================================================================

# AWS SES (Default email provider)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_SES_FROM_EMAIL=noreply@yourdomain.com
AWS_SES_FROM_NAME=Your App Name

# =============================================================================
# REGIONAL SMS PROVIDERS
# =============================================================================

# Termii (Africa-focused SMS)
TERMII_API_KEY=TLyour-termii-api-key
TERMII_SENDER_ID=YourApp

# AfricasTalking (Africa-focused SMS)
AFRICASTALKING_API_KEY=your-africastalking-api-key
AFRICASTALKING_USERNAME=your-africastalking-username
AFRICASTALKING_SHORT_CODE=your-short-code

# =============================================================================
# PUSH NOTIFICATION PROVIDER
# =============================================================================

# AWS SNS (Default push provider)
AWS_SNS_ACCESS_KEY_ID=your-aws-access-key
AWS_SNS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_SNS_REGION=us-east-1



# =============================================================================
# IN-APP NOTIFICATIONS
# =============================================================================

# WebSocket shares the same port as the main application (PORT)

# =============================================================================
# OAUTH PROVIDERS (Authentication)
# =============================================================================

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/oauth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/oauth/github/callback



# =============================================================================
# RATE LIMITING
# =============================================================================

# Rate Limiting
DEFAULT_RATE_LIMIT=100
RATE_LIMIT_WINDOW=60

# =============================================================================
# LOGGING
# =============================================================================

# Logging Configuration
LOG_LEVEL=info

# =============================================================================
# USAGE TRACKING
# =============================================================================

# Usage Tracking
USAGE_TRACKING_ENABLED=true

# =============================================================================
# DEVELOPMENT & TESTING
# =============================================================================

# Development Mode Settings
CORS_ORIGIN=http://localhost:3001

# =============================================================================
# PROVIDER CONFIGURATION
# =============================================================================

# Provider Configuration (Regional SMS routing + Fallback providers)
SMS_AFRICA=africastalking
SMS_NORTH_AMERICA=telnyx
SMS_EUROPE=telnyx
SMS_ASIA_PACIFIC=telnyx
SMS_LATIN_AMERICA=telnyx
SMS_MIDDLE_EAST=telnyx
SMS_GLOBAL=telnyx

EMAIL_PROVIDER=ses
PUSH_PROVIDER=sns
VOICE_PROVIDER=telnyx-voice
IN_APP_PROVIDER=sse

# =============================================================================
# NOTES
# =============================================================================

# REQUIRED VARIABLES:
# - JWT_AUTH_SECRET (must be at least 32 characters)
# - JWT_REFRESH_SECRET (must be at least 32 characters)
# - PROVIDER_ENCRYPTION_KEY (must be exactly 32 characters)
# - Database configuration (DATABASE_URL)
# - Redis configuration (REDIS_URL)
# - Regional SMS provider credentials (AfricasTalking for Africa, Telnyx for others)
# - Email/Push provider credentials (AWS SES/SNS)
# - WhatsApp credentials for chat notifications (optional)
# - OAuth credentials for Google and GitHub authentication (optional but recommended)

# PROVIDER SETUP GUIDES:
# 
# TELNYX (Primary SMS + Voice):
# 1. Sign up at https://telnyx.com
# 2. Get API key from dashboard
# 3. Purchase a phone number
# 4. Create messaging profile and voice connection
# 5. Set up webhooks: https://your-domain.com/webhooks/telnyx
#
# WHATSAPP BUSINESS API:
# 1. Create Meta Business Account at business.facebook.com
# 2. Create Meta App at developers.facebook.com
# 3. Add WhatsApp Business API product
# 4. Get access token, phone number ID, business account ID
# 5. Set up webhooks: https://your-domain.com/webhooks/whatsapp
#
# AFRICASTALKING (Africa SMS):
# 1. Sign up at https://africastalking.com
# 2. Get API key and username
# 3. Purchase SMS credits
#
# TERMII (Africa SMS):
# 1. Sign up at https://termii.com
# 2. Get API key and sender ID
# 3. Purchase SMS credits
#
# AWS SES (Email):
# 1. Create AWS account and configure SES
# 2. Verify your domain and email addresses
# 3. Get access key and secret key
#
# AWS SNS (Push):
# 1. Create AWS account and configure SNS
# 2. Set up platform applications for iOS/Android
# 3. Get access key and secret key
#
# GOOGLE OAUTH:
# 1. Go to Google Cloud Console (console.cloud.google.com)
# 2. Create a new project or select existing
# 3. Enable Google+ API
# 4. Create OAuth 2.0 credentials
# 5. Add authorized redirect URI: http://localhost:3000/auth/oauth/google/callback
#
# GITHUB OAUTH:
# 1. Go to GitHub Settings > Developer settings > OAuth Apps
# 2. Create a new OAuth App
# 3. Set Authorization callback URL: http://localhost:3000/auth/oauth/github/callback
# 4. Get Client ID and Client Secret

# SECURITY NOTES:
# - Never commit real API keys to version control
# - Use different keys for development/staging/production
# - Rotate keys regularly
# - Store sensitive keys in secure key management systems for production