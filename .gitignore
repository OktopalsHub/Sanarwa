# Dependencies & build
node_modules/
dist/
coverage/
*.log
*.tsbuildinfo

# Env (allow only .env.example)
.env
.env.*
!.env.example
!**/.env.example

# Framework / tooling caches
.next/
.output/
.nitro/
.tanstack/
.turbo/
.fallow/
.nx/
.cache/

# Dotfiles / agent / editor (allow only .github and .env.example)
.*
!.gitignore
!.env.example
!**/.env.example
!.github/
!.github/**

# Markdown: only root README (Mintlify docs are .mdx under docs/)
*.md
!/README.md

# Config that stays local / tool-owned
*.toml

# Agent skills / locks (local only)
skills-lock.json
.agents/
.hallmark/
.ponytail/
**/ponytail/**

# OS
.DS_Store
Thumbs.db

# Local scratch dirs (do not use *temp*/*cache*/*logs* — those match source names like template.ts)
**/tmp/
**/temp/
**/.cache/
**/logs/
*.tmp
*.bak
**/backup/

# Mintlify docs
!docs/
!docs/**

.cursor