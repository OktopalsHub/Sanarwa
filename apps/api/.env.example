NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3001

DATABASE_URL=postgresql://username:password@localhost:5432/sanarwa
REDIS_URL=redis://localhost:6379

JWT_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-32-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3001,http://localhost:3000
SESSION_SECRET=change-me-to-another-long-random-string-32+
PROVIDER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

CORS_ORIGIN=http://localhost:3001
LOG_LEVEL=info

# MCP server (agents connect here; URL the OAuth resource metadata advertises)
MCP_RESOURCE=http://localhost:3000/mcp
MCP_AUTHORIZATION_SERVER=http://localhost:3000

# Email (ZeptoMail — managed provider)
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_FROM_EMAIL=noreply@example.com
ZEPTOMAIL_FROM_NAME=Sanarwa
ZEPTOMAIL_REPLY_TO_EMAIL=

# AWS (SNS/Pinpoint). SES is BYOP-only and configured per tenant.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# SMS / voice
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_CONNECTION_ID=
TELNYX_PUBLIC_KEY=
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_WEBHOOK_SECRET=
TERMII_WEBHOOK_SECRET=
INFOBIP_WEBHOOK_SECRET=
TERMII_API_KEY=
TERMII_SENDER_ID=

# WhatsApp (Embedded Signup only — sending credentials are per-tenant BYOP)
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Meta app used for tenant-owned WhatsApp Embedded Signup
META_APP_ID=
META_CONFIG_ID=
META_APP_SECRET=
WHATSAPP_APP_SECRET=

# Web push (VAPID). Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# Inbound email (signed Reply-To token). Long random secret shared with the
# mail worker; the API never accepts a secret from the request body.
INBOUND_EMAIL_SECRET=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/oauth/github/callback

# Billing — Bachs is the only payment provider (USD and NGN).
# Card vault uses the same products with a small setup charge.

# Bachs (CUSTOM products; amount set per checkout)
BACHS_SECRET_KEY=
BACHS_WEBHOOK_SECRET=
BACHS_BASE_URL=https://sandbox-api.bachs.io
BACHS_PRODUCT_ID_USD=
BACHS_PRODUCT_ID_NGN=
BACHS_CARD_SETUP_AMOUNT=1.00
