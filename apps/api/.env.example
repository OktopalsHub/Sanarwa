NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3001

DATABASE_URL=postgresql://username:password@localhost:5432/sanarwa
REDIS_URL=redis://localhost:6379

AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_SECRET=change-me-to-another-long-random-string-32+
PROVIDER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

CORS_ORIGIN=http://localhost:3001
LOG_LEVEL=info
SENTRY_DSN=

# Email (SES)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_SES_FROM_EMAIL=noreply@example.com
AWS_SES_FROM_NAME=Sanarwa

# SMS / voice
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_CONNECTION_ID=
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
TERMII_API_KEY=
TERMII_SENDER_ID=

# WhatsApp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/oauth/github/callback

# Billing — NGN: Nomba → Bachs | USD: Bachs → Polar
# Card vault uses the same products/accounts with a small setup charge.

# Bachs (CUSTOM products; amount set per checkout)
BACHS_SECRET_KEY=
BACHS_WEBHOOK_SECRET=
BACHS_BASE_URL=https://sandbox-api.bachs.io
BACHS_PRODUCT_ID_USD=
BACHS_PRODUCT_ID_NGN=
BACHS_CARD_SETUP_AMOUNT=1.00

# Polar (USD fallback; ad-hoc prices in cents)
POLAR_API_KEY=
POLAR_WEBHOOK_SECRET=
POLAR_BASE_URL=https://api.polar.sh
POLAR_PRODUCT_ID=
POLAR_CARD_SETUP_AMOUNT_CENTS=100

# Nomba (NGN; no product IDs — parent header, sub deposit account)
NOMBA_CLIENT_ID=
NOMBA_CLIENT_SECRET=
NOMBA_PARENT_ACCOUNT_ID=
NOMBA_SUB_ACCOUNT_ID=
NOMBA_BASE_URL=https://sandbox.nomba.com
NOMBA_WEBHOOK_SECRET=
NOMBA_CARD_SETUP_AMOUNT=100
