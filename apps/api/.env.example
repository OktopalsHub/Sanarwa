NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3001

DATABASE_URL=postgresql://username:password@localhost:5432/sanarwa
REDIS_URL=redis://localhost:6379

AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_SECRET=change-me-to-another-long-random-string-32+
PROVIDER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

CORS_ORIGIN=http://localhost:3001
LOG_LEVEL=info

# Optional — email (SES)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_SES_FROM_EMAIL=noreply@example.com
AWS_SES_FROM_NAME=Sanarwa

# Optional — SMS / voice
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_CONNECTION_ID=
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
TERMII_API_KEY=
TERMII_SENDER_ID=

# Optional — WhatsApp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Optional — OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/oauth/github/callback

# Optional — billing
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
