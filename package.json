{
  "name": "sanarwa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --filter=@sanarwa/web --filter=@sanarwa/api",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "oxlint -c oxlint.json apps packages --quiet",
    "lint:all": "oxlint -c oxlint.json apps packages",
    "lint:fix": "oxlint -c oxlint.json apps packages --fix && oxfmt . --ignore-path .oxfmtignore",
    "fmt": "oxfmt . --ignore-path .oxfmtignore",
    "fmt:check": "oxfmt --check . --ignore-path .oxfmtignore",
    "type-check": "turbo run type-check",
    "deploy:local": "docker compose up --build",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f docker-compose.dev.yml down"
  },
  "devDependencies": {
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.25.0",
  "pnpm": {
    "overrides": {
      "react": "19.3.1",
      "react-dom": "19.3.1"
    }
  }
}
