{
  "name": "@sanarwa/sdk",
  "version": "0.2.0",
  "description": "Official TypeScript/JavaScript SDK for Sanarwa Notification Platform API",
  "keywords": [
    "api",
    "email",
    "notification",
    "push",
    "sanarwa",
    "sdk",
    "sms",
    "voice",
    "whatsapp"
  ],
  "homepage": "https://docs.sanarwa.com",
  "bugs": {
    "url": "https://github.com/sanarwa/sdk/issues"
  },
  "license": "MIT",
  "author": "Sanarwa",
  "repository": {
    "type": "git",
    "url": "https://github.com/sanarwa/sdk"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint -c ../../oxlint.json src",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@sanarwa/shared-types": "workspace:*",
    "axios": "^1.21.1"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "rollup": "^4.68.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
