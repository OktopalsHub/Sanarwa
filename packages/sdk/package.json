{
  "name": "@sanarwa/sdk",
  "version": "0.2.0",
  "description": "Official TypeScript/JavaScript SDK for Sanarwa Notification Platform API",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "QUICK-REFERENCE.md",
    "RAW-HTML-GUIDE.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint -c ../../oxlint.json src",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "sanarwa",
    "notification",
    "api",
    "sdk",
    "email",
    "sms",
    "push",
    "whatsapp",
    "voice"
  ],
  "author": "Sanarwa",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.5",
    "rollup": "^4.6.1",
    "typescript": "^5.3.2",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "tslib": "^2.8.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sanarwa/sdk"
  },
  "bugs": {
    "url": "https://github.com/sanarwa/sdk/issues"
  },
  "homepage": "https://docs.sanarwa.com"
}
